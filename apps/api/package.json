{
  "name": "@ocm/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "auth:setup": "tsx scripts/auth-setup.ts",
    "auth:reset-password": "tsx scripts/auth-reset-password.ts",
    "auth:disable-totp": "tsx scripts/auth-disable-totp.ts",
    "auth:sessions": "tsx scripts/auth-sessions.ts",
    "project:add": "tsx scripts/project-add.ts",
    "supervisor": "node ../../host/host-supervisor.mjs",
    "auth:enable-totp": "tsx scripts/auth-enable-totp.ts",
    "auth:check-totp": "tsx scripts/auth-check-totp.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "grammy": "^1.33.0",
    "otplib": "^12.0.1",
    "qrcode-terminal": "^0.12.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.2.6",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
