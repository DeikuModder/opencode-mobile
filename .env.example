# Copy to .env and fill in. NEVER commit .env.
# Local usage:  .env sits in the project root, loaded by the API.
# Docker usage: compose reads it via env_file and injects into the container.

# ── Public origin(s) ─────────────────────────────────────────────────────────
# The scheme+host the browser uses. Used to validate the Origin header on every
# mutating request (CSRF defence). No trailing slash. e.g. https://ocm.example.com
#
# A comma-separated list is allowed, because several origins are legitimately in
# play at once: the Vite dev server, the API on its own port, a LAN address, and
# a tunnel hostname all coexist during development. Anything not listed is
# rejected with 403 bad_origin.
#
# An http:// entry is only accepted for loopback hosts. A non-loopback http origin
# would put the session cookie on the wire in cleartext, so the API refuses to
# start rather than let that be discovered in review.
#
# Both loopback spellings are listed for the gateway: http://localhost:3000 and
# http://127.0.0.1:3000 are different origins to a browser even though they reach
# the same process, so a tab opened on whichever one you type will get 403
# bad_origin unless it appears here. 5173 is Vite's dev-server port.
APP_ORIGIN=http://localhost:3000,http://127.0.0.1:3000,http://127.0.0.1:5173

# ── Gateway ──────────────────────────────────────────────────────────────────
PORT=3000
# Interface to bind. Loopback is correct for the intended deployment: cloudflared
# runs on this same host and connects over 127.0.0.1, so the gateway never needs a
# routable address. Setting 0.0.0.0 publishes the login endpoint — and, through
# the proxy, a full coding agent — to every host on the network. The API logs a
# warning when it is not loopback.
GATEWAY_BIND_HOST=127.0.0.1
LOG_LEVEL=info
# Absolute or relative to the project root. Holds auth.db.
DATA_DIR=./data
LOG_DIR=./logs

# ── Sessions ─────────────────────────────────────────────────────────────────
# Opaque session cookie lifetime, and how often to persist the slid expiry.
SESSION_TTL_DAYS=30
SESSION_SLIDE_INTERVAL_MINUTES=60
# The __Host- prefix is browser-enforced: the cookie is rejected unless it is
# Secure, Path=/, and has no Domain. Keep it in production.
#
# For plain-HTTP local development against http://localhost, set this to
# `ocm_session` instead. Safari refuses to store a Secure cookie over plain HTTP
# even on localhost (Chrome and Firefox allow it), so with the default name the
# login appears to succeed and then silently fails to persist.
SESSION_COOKIE_NAME=__Host-ocm_session

# ── Rate limiting ────────────────────────────────────────────────────────────
# Per client IP, fixed one-minute windows. Login gets its own, much tighter
# bucket because it is the only unauthenticated write.
RATE_LIMIT_GLOBAL_PER_MINUTE=300
RATE_LIMIT_LOGIN_PER_MINUTE=8

# ── opencode serve (upstream) ────────────────────────────────────────────────
# Basic-auth password the gateway presents to `serve`. Generated once; must match
# what the host supervisor sets in OPENCODE_SERVER_PASSWORD. The browser never
# sees this — it is injected by the gateway on the proxy hop only.
SERVE_PASSWORD=
# How the gateway reaches the upstream `serve`. The gateway talks to it directly
# (proxy and Telegram event pump), so this has to be the host where serve runs.
#   native  -> 127.0.0.1
#   docker  -> host.docker.internal  (the host, from inside the container)
# Left blank it assumes the Docker case, which is why an unset value breaks a
# native run with a confusing ECONNREFUSED rather than an obvious one.
SERVE_HOST=127.0.0.1
# Where the host supervisor should bind each `serve` instance.
SERVE_BIND_HOST=0.0.0.0
# First port of the per-project range; each project gets base + index.
SERVE_PORT_BASE=4101
# Minutes an idle project stays resident before the supervisor stops it.
SERVE_IDLE_SHUTDOWN_MINUTES=30

# ── SSE hub (gateway → serve) ─────────────────────────────────────────────────
# The gateway keeps at most ONE upstream event connection per project and fans
# it out to all browser tabs and the notifier. These tune the shared connection.
# Seconds a project's upstream connection lingers after its last subscriber
# leaves, so reopening a tab does not re-dial. Raise it if tabs are being
# closed and reopened often.
EVENT_HUB_IDLE_GRACE_MS=30000
# First and last backoff step when the upstream connection drops. Bounded so a
# long outage is still retried, rather than parked.
EVENT_HUB_RETRY_MIN_MS=1000
EVENT_HUB_RETRY_MAX_MS=30000
# Consecutive failed attempts before browser responses are ended. Ending them
# makes the browser's own EventSource reconnect and refetch, instead of leaving
# a tab silently stale. Internal subscribers (the notifier) are never flushed.
EVENT_HUB_MAX_SILENT_FAILURES=5
# Per-client buffer ceiling in bytes. A browser too slow to read is dropped
# rather than allowed to stall the shared stream for every other subscriber.
EVENT_HUB_MAX_CLIENT_BUFFER_BYTES=1048576

# ── Host supervisor (runs on Windows, not in the container) ──────────────────
# Reached from the container as http://host.docker.internal:4100
SUPERVISOR_URL=http://host.docker.internal:4100
SUPERVISOR_PORT=4100
# Where the supervisor listens. It spawns processes, so it MUST be reachable by
# the container — which means 0.0.0.0 whenever the gateway runs in Docker.
# SUPERVISOR_BIND_HOST=127.0.0.1
# Shared secret required on every supervisor request. Without it the port is a
# remote-code-execution endpoint for anything that can route to it, so the
# firewall must also block this port from the LAN. Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SUPERVISOR_TOKEN=
# Absolute path to the real binary. NEVER the opencode.cmd shim: Node >=18.20
# refuses to spawn .cmd with shell:false (EINVAL). Left blank, the supervisor
# resolves it via `npm root -g`.
# OPENCODE_BIN=C:\Users\Usuario\AppData\Roaming\npm\node_modules\opencode-ai\bin\opencode.exe
# Pinned for reproducible behaviour. Verified against this build.
OPENCODE_VERSION=1.18.33

# ── Telegram notifier ────────────────────────────────────────────────────────
# From @BotFather. Leave blank to disable the notifier entirely.
TELEGRAM_BOT_TOKEN=
# Your numeric user id from @userinfobot. Commands are ignored from anyone else.
TELEGRAM_ALLOWED_USER_ID=
# Deep link back into the web app, used in notification buttons.
TELEGRAM_APP_URL=
